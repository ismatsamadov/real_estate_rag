# --- Required secrets ---------------------------------------------------------
# Postgres connection string. Must point at a database with the pgvector
# extension available (Neon, Supabase, RDS w/ pgvector, or self-hosted).
DATABASE_URL=

# Anthropic API key for answer generation.
ANTHROPIC_API_KEY=

# Firecrawl API key (only needed by `npm run scrape`).
FIRECRAWL_API_KEY=

# --- Server -------------------------------------------------------------------
PORT=8787
NODE_ENV=development
LOG_LEVEL=info
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=30

# --- Retrieval / generation ---------------------------------------------------
# Embedding model that runs locally via @xenova/transformers. Must match
# VECTOR_DIM. Changing this requires re-ingesting the corpus.
EMBEDDING_MODEL=Xenova/all-MiniLM-L6-v2
VECTOR_DIM=384

# Postgres table name for chunk storage.
PGVECTOR_TABLE=rag_chunks

# Default Anthropic model. Comma-separated fallbacks are tried on 404.
ANTHROPIC_MODEL=claude-sonnet-4-5
ANTHROPIC_MODEL_CANDIDATES=claude-sonnet-4-5,claude-haiku-4-5-20251001

# Retrieval depth and answer length.
RAG_TOP_K=8
RAG_CANDIDATE_K=24
RAG_MAX_TOKENS=900
RAG_TEMPERATURE=0

# Hybrid retrieval mix: 'hybrid' (vector + lexical w/ RRF), 'vector', or 'lexical'.
RAG_MODE=hybrid
RRF_K=60

# --- Ingestion ----------------------------------------------------------------
CHUNK_SIZE=1200
CHUNK_OVERLAP=180
MIN_CHUNK_SIZE=200
INGEST_BATCH_SIZE=32
EMBED_BATCH_SIZE=16

# --- Scraping -----------------------------------------------------------------
SITEMAP_URL=https://pasharealestate.az/sitemap.xml
SCRAPE_CONCURRENCY=4
SCRAPE_RETRY_MAX=3
ALLOW_INSECURE_SITEMAP_TLS=0

# Override the default I/O paths (relative to repo root).
INPUT_JSONL=data/corpus.jsonl
OUTPUT_JSONL=data/corpus.jsonl

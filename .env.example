# =============================================================================
# REQUIRED SECRETS (3 of them; everything else has a sane default in config.js)
# =============================================================================

# Postgres connection string. Neon is the supported default — must have the
# pgvector extension available. Example:
# postgresql://user:pass@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# Anthropic API key for answer generation (sk-ant-...).
ANTHROPIC_API_KEY=

# Voyage AI key for both embeddings and reranking (pa-...).
# Either VOYAGE_AI_API_KEY or VOYAGE_API_KEY is accepted — the config falls
# back from one to the other so the welcome-email name and brand name both work.
VOYAGE_AI_API_KEY=

# Firecrawl API key. Only used by `npm run scrape`. Leave blank if you only
# run the app against an already-ingested corpus.
FIRECRAWL_API_KEY=

# =============================================================================
# Server runtime
# =============================================================================

# HTTP port for the Next.js server (dev + `next start`).
PORT=3000

# Node env: "development" | "production" | "test". Drives prod-only behaviors
# such as cookie `secure: true`.
NODE_ENV=development

# pino log level: trace | debug | info | warn | error | fatal | silent.
LOG_LEVEL=info

# Sliding window for the per-IP rate limiter (ms) and max requests inside it.
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=30

# Comma-separated allowed origins for CORS on the API routes. Empty disables
# CORS (same-origin only). Use "*" ONLY for local dev.
ALLOWED_ORIGINS=

# =============================================================================
# Embeddings & retrieval
# =============================================================================

# Voyage embedding model. voyage-4-large is the multilingual flagship (1024-d).
# Alternatives: voyage-4 (balanced), voyage-4-lite (cheaper, still 1024-d).
# Changing this requires re-ingesting the entire corpus.
VOYAGE_EMBED_MODEL=voyage-4-large

# Output dimensions of the embedding model. MUST match the chosen model.
# voyage-4-* default = 1024.
VECTOR_DIM=1024

# Voyage reranker model. rerank-2.5 is the current best multilingual cross-encoder.
VOYAGE_RERANK_MODEL=rerank-2.5

# Free-tier throttle (requests per minute). Voyage caps unpaid accounts at
# 3 RPM / 10K TPM until a payment method is on file. Set to 3 to ride the
# free tier without 429s; 0 disables the throttle (recommended once paid).
VOYAGE_RPM=0

# Postgres table name for chunks. Regex-validated as a SQL identifier.
# Change only if you co-host multiple RAG corpora in one database.
PGVECTOR_TABLE=rag_chunks

# Default Anthropic model. Fallback chain is tried in order if the primary
# returns 404 / not_found_error. 429/529 are retried within the primary first.
ANTHROPIC_MODEL=claude-sonnet-4-6
ANTHROPIC_MODEL_CANDIDATES=claude-sonnet-4-6,claude-haiku-4-5-20251001

# Retrieval depth.
# CANDIDATE_K = chunks pulled from Postgres before rerank.
# TOP_K       = chunks that survive rerank and go to the LLM as sources.
RAG_TOP_K=8
RAG_CANDIDATE_K=32

# Max output tokens from Anthropic. Sonnet completions for grounded QA
# rarely need more than ~900.
RAG_MAX_TOKENS=900

# LLM sampling temperature. 0 = deterministic; we leave it at 0 for grounded QA.
RAG_TEMPERATURE=0

# Retrieval strategy:
#   hybrid  → vector kNN + Postgres FTS, fused via RRF (recommended)
#   vector  → ANN only (skips lexical entirely)
#   lexical → BM25-style FTS only (no embedding cost)
RAG_MODE=hybrid

# RRF constant from Cormack et al. 2009. Standard value; rarely worth tuning.
# Higher values flatten the fusion; lower values amplify top-rank dominance.
RRF_K=60

# Toggle Voyage cross-encoder rerank on the candidate set. Strongly recommended.
RAG_RERANK=true

# In-process LRU retrieval cache (per-query memoization on the API route).
# TTL=0 disables caching. MAX is the number of entries before LRU eviction.
RAG_CACHE_TTL_MS=300000
RAG_CACHE_MAX=500

# =============================================================================
# Ingestion (offline pipeline — npm run ingest)
# =============================================================================

# Article splitter parameters. Listings ignore these (1 atomic chunk per listing).
# CHUNK_SIZE   = hard max characters per chunk
# CHUNK_OVERLAP = trailing chars carried into the next chunk, snapped to a
#                 sentence/word boundary so cross-chunk facts can still be answered
# MIN_CHUNK_SIZE = undersized tail chunks below this size are merged into the prior chunk
CHUNK_SIZE=1200
CHUNK_OVERLAP=180
MIN_CHUNK_SIZE=200

# DB upsert batch size (rows per INSERT … VALUES … parameter set).
INGEST_BATCH_SIZE=32

# Embedding batch size (chunks per Voyage embed request). Voyage caps at 128.
# Smaller batches help stay under the free-tier 10K TPM ceiling.
EMBED_BATCH_SIZE=32

# =============================================================================
# Scraping (offline pipeline — npm run scrape)
# =============================================================================

# Source site root. The scraper discovers URLs via Firecrawl's mapUrl
# (sitemap ∪ crawl), then filters by language and content type.
SITEMAP_URL=https://pasharealestate.az/sitemap.xml
SCRAPE_BASE_URL=https://pasharealestate.az

# Concurrent Firecrawl scrape requests (also passed as Firecrawl's maxConcurrency).
SCRAPE_CONCURRENCY=4

# Max retries per page on transient failures (exp-backoff + jitter).
SCRAPE_RETRY_MAX=3

# Upper bound on pages scraped per run. Defensive cap so a misconfig doesn't
# burn through Firecrawl credits on a runaway site.
SCRAPE_MAX_PAGES=2000

# Languages to keep (detected from /en, /az, /ru path prefix). Comma-separated.
SCRAPE_LANGUAGES=en,az,ru

# Reserved for a future Playwright fallback for hard-JS-rendered pages.
# Firecrawl already renders JS via headless Chromium, so this is currently a no-op.
SCRAPE_USE_PLAYWRIGHT=true

# Disable TLS verification for the sitemap fetch. 0 = strict (default), 1 = lax.
# Useful only against staging sites with self-signed certs.
ALLOW_INSECURE_SITEMAP_TLS=0

# I/O paths (relative to repo root). Override only if you're juggling multiple
# corpora in one repo.
INPUT_JSONL=data/corpus.jsonl
OUTPUT_JSONL=data/corpus.jsonl

# =============================================================================
# Observability (optional — leave blank to disable)
# =============================================================================

# Axiom dataset name + ingest token for OpenTelemetry traces. When both are
# set, the app initializes an OTLP exporter. Otherwise tracing is off and
# pino logs remain the only signal.
AXIOM_DATASET=
AXIOM_TOKEN=

# Service name attached to all traces/spans.
OTEL_SERVICE_NAME=real-estate-rag

# =============================================================================
# Demo auth (gates the UI behind a shared credential)
# =============================================================================

# Single shared username + password for the demo UI. BOTH ARE REQUIRED —
# the app refuses to start without them, and DEMO_PASSWORD must be ≥8 chars.
# NOT production auth — for a real deployment swap in NextAuth + a proper
# IdP (Google, GitHub, magic link). The middleware + cookie pattern stays;
# only the credential check changes.
DEMO_USERNAME=change-me
DEMO_PASSWORD=change-me-strong-password

# =============================================================================
# Required secrets
# =============================================================================

# Postgres connection string (Neon recommended). Must have pgvector available.
# Example: postgresql://user:pass@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# Anthropic API key for answer generation.
ANTHROPIC_API_KEY=

# Voyage AI key for embeddings + reranking (https://voyageai.com).
VOYAGE_AI_API_KEY=

# Firecrawl API key (only needed by `npm run scrape`).
FIRECRAWL_API_KEY=

# =============================================================================
# Server
# =============================================================================
PORT=8787
NODE_ENV=development
LOG_LEVEL=info
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=30

# Comma-separated list of allowed origins for CORS (Next.js frontend, etc.).
# Leave empty to disable CORS. Use '*' only for local dev.
ALLOWED_ORIGINS=http://localhost:3000

# =============================================================================
# Embeddings & retrieval
# =============================================================================

# Voyage embedding model. voyage-4-large is best multilingual quality (1024d).
# Alternatives: voyage-4 (balanced), voyage-4-lite (cheaper, still 1024d).
# Changing this requires re-ingesting the corpus.
VOYAGE_EMBED_MODEL=voyage-4-large
VECTOR_DIM=1024

# Voyage reranker model. rerank-2.5 is the current best multilingual cross-encoder.
VOYAGE_RERANK_MODEL=rerank-2.5

# Postgres table name for chunk storage.
PGVECTOR_TABLE=rag_chunks

# Default Anthropic model + fallback chain (tried in order on 404/429/529).
ANTHROPIC_MODEL=claude-sonnet-4-6
ANTHROPIC_MODEL_CANDIDATES=claude-sonnet-4-6,claude-haiku-4-5-20251001

# Retrieval depth.
# CANDIDATE_K is how many we pull from Postgres for reranking;
# TOP_K is how many survive rerank and go to the LLM.
RAG_TOP_K=8
RAG_CANDIDATE_K=32
RAG_MAX_TOKENS=900
RAG_TEMPERATURE=0

# Hybrid retrieval mode: 'hybrid' (vector + lexical w/ RRF) | 'vector' | 'lexical'.
RAG_MODE=hybrid
RRF_K=60

# Toggle Voyage reranking on the candidate set. Recommended: on.
RAG_RERANK=true

# In-memory retrieval cache TTL (ms). 0 disables caching.
RAG_CACHE_TTL_MS=300000
RAG_CACHE_MAX=500

# =============================================================================
# Ingestion
# =============================================================================
CHUNK_SIZE=1200
CHUNK_OVERLAP=180
MIN_CHUNK_SIZE=200
INGEST_BATCH_SIZE=32
EMBED_BATCH_SIZE=64

# =============================================================================
# Scraping
# =============================================================================
SITEMAP_URL=https://pasharealestate.az/sitemap.xml
SCRAPE_BASE_URL=https://pasharealestate.az
SCRAPE_CONCURRENCY=4
SCRAPE_RETRY_MAX=3
SCRAPE_MAX_PAGES=2000
SCRAPE_LANGUAGES=en,az,ru
SCRAPE_USE_PLAYWRIGHT=true
ALLOW_INSECURE_SITEMAP_TLS=0

# Override default I/O paths (relative to repo root).
INPUT_JSONL=data/corpus.jsonl
OUTPUT_JSONL=data/corpus.jsonl

# =============================================================================
# Observability (optional)
# =============================================================================
# Axiom dataset + token for OpenTelemetry traces. Leave blank to disable.
AXIOM_DATASET=
AXIOM_TOKEN=
OTEL_SERVICE_NAME=real-estate-rag
